#!/usr/bin/env bash

detect_source_path() {
    local source_path

    # local path for zsh when script is sourced
    if [[ -n "${ZSH_VERSION:-}" ]] && [[ -n "${funcfiletrace[1]:-}" ]]; then
        source_path="${funcfiletrace[1]%%:*}"

    # local path for bash when script is sourced
    elif [[ -n "${BASH_SOURCE[0]:-}" ]]; then
        source_path="${BASH_SOURCE[0]}"
    else
        return 1
    fi

    # local path -> full path
    if [[ "$source_path" != /* ]]; then
        source_path="$PWD/$source_path"
    fi

    if [[ -z "$source_path" || ! -f "$source_path" ]]; then
        return 1
    fi

    printf "%s\n" "$source_path"
}

set_shellbox_dir() {
    local source_path
    source_path="$(detect_source_path)" || {
        printf "setup/init: unable to determine SHELLBOX_DIR\n" >&2
        return 1
    }

    # resolve project root relative to this file.
    SHELLBOX_DIR="$(cd "$(dirname "$source_path")/.." && pwd)"
    export SHELLBOX_DIR
}

ensure_bin_path() {
    local bin_dir="$SHELLBOX_DIR/bin"
    # ensure a bin directory exists for symlinked scripts
    if [[ ! -d "$bin_dir" ]]; then
        mkdir -p "$bin_dir"
    fi

    # prepend to PATH once
    case ":$PATH:" in
    *":$bin_dir:"*) ;;
    *)
        PATH="$bin_dir:$PATH"
        ;;
    esac

    export PATH
}

ensure_domains_dir() {
    local domains_dir="$SHELLBOX_DIR/domains"

    if [[ ! -d "$domains_dir" ]]; then
        mkdir -p "$domains_dir"
    fi
}

clear_script_links() {
    local bin_dir="$SHELLBOX_DIR/bin"
    local link
    local target

    # Remove generated links, including links from the old modules/ layout.
    while IFS= read -r -d '' link; do
        target="$(readlink "$link" 2>/dev/null || true)"
        case "$target" in
        "$SHELLBOX_DIR"/example-domains/*/scripts/* | \
            "$SHELLBOX_DIR"/domains/*/scripts/* | \
            "$SHELLBOX_DIR"/modules/*/scripts/* | \
            "$SHELLBOX_DIR"/scripts/*)
            rm -f "$link"
            ;;
        esac
    done < <(find "$bin_dir" -maxdepth 1 -type l -print0)
}

link_scripts() {
    local domains_dir=$1
    local bin_dir="$SHELLBOX_DIR/bin"
    local script
    local first
    local script_name

    if [[ ! -d "$domains_dir" ]]; then
        return 0
    fi

    # link scripts into bin.
    while IFS= read -r -d '' script; do
        IFS= read -r first <"$script" || continue
        case "$first" in
        '#!'*)
            chmod +x "$script" 2>/dev/null || true
            script_name="$(basename "$script")"
            ln -sfn "$script" "$bin_dir/$script_name"
            ;;
        esac
    done < <(find "$domains_dir" -type d -name .git -prune -o \
        -type f -path '*/scripts/*' -print0)

}

source_functions() {
    local domains_dir=$1
    local func_file
    local first

    if [[ ! -d "$domains_dir" ]]; then
        return 0
    fi

    # source functions files (only source shebang files)
    while IFS= read -r -d '' func_file; do
        IFS= read -r first <"$func_file" || continue
        case "$first" in
        '#!'*)
            # shellcheck source=/dev/null
            . "$func_file"
            ;;
        esac
    done < <(find "$domains_dir" -type d -name .git -prune -o \
        -type f -path '*/functions/*' -print0)
}

source_aliases() {
    local domains_dir=$1
    local alias_file

    if [[ ! -d "$domains_dir" ]]; then
        return 0
    fi

    # source aliases files
    while IFS= read -r -d '' alias_file; do
        # shellcheck source=/dev/null
        . "$alias_file"
    done < <(find "$domains_dir" -type d -name .git -prune -o \
        -type f -name 'aliases' -print0)
}

load_domains() {
    local domains_dir=$1

    link_scripts "$domains_dir"
    source_functions "$domains_dir"
    source_aliases "$domains_dir"
}

main() {
    local load_examples=0

    if [[ "$#" -eq 1 ]]; then
        case "${1:-}" in
        --with-examples) load_examples=1 ;;
        --domains-only) ;;
        esac
    fi

    if ! set_shellbox_dir; then
        return 1
    fi

    if [[ ! -d "$SHELLBOX_DIR/example-domains" ]]; then
        return 1
    fi

    # wire up PATH, links, and shell helpers.
    ensure_domains_dir || return $?
    ensure_bin_path
    clear_script_links
    if ((load_examples)); then
        load_domains "$SHELLBOX_DIR/example-domains"
    fi
    load_domains "$SHELLBOX_DIR/domains"

}

main "$@"
